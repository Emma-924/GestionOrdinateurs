@page "/login"

@inject IHttpClientFactory Factory
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation

@* Page de connexion : demande un token à Keycloak (via l'API d'authentification) et l'enregistre en session. *@

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

<input class="form-control" @bind="LoginSaisi" placeholder="Login (ex : user1)" />

<input class="form-control mt-2" type="password" @bind="MotDePasse" placeholder="Mot de passe" />

<button class="btn btn-primary mt-2" @onclick="SeConnecter">Connecter</button>

<p class="text-danger mt-2">@Message</p>

@code {
    private string LoginSaisi = "";
    private string MotDePasse = "";
    private string Message = "";

    // Envoie le login et le mot de passe, enregistre le token Keycloak en session puis redirige vers l'accueil (message adapté en cas d'erreur).
    private async Task SeConnecter()
    {
        if (string.IsNullOrWhiteSpace(LoginSaisi) || string.IsNullOrWhiteSpace(MotDePasse))
        {
            Message = "Veuillez saisir un login et un mot de passe.";
            return;
        }

        var clientAuth = Factory.CreateClient("AuthApi");

        HttpResponseMessage reponse;
        try
        {
            reponse = await clientAuth.PostAsJsonAsync("Authentication/keycloak-login", new LoginRequest(LoginSaisi, MotDePasse));
        }
        catch (HttpRequestException)
        {
            Message = "Impossible de joindre le service d'authentification.";
            return;
        }

        if (reponse.StatusCode == HttpStatusCode.Unauthorized)
        {
            Message = "Login ou mot de passe incorrect.";
            return;
        }

        if (!reponse.IsSuccessStatusCode)
        {
            Message = $"Erreur du service d'authentification ({(int)reponse.StatusCode}).";
            return;
        }

        var token = await reponse.Content.ReadAsStringAsync();

        await SessionStorage.SetItemAsync("jwtToken", token);
        Navigation.NavigateTo("/");
    }
}